{
  "name": "@repo/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./models/*": {
      "types": "./dist/models/*.d.ts",
      "default": "./dist/models/*.js"
    },
    "./temporal/*": {
      "types": "./dist/temporal/*.d.ts",
      "default": "./dist/temporal/*.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsc --build --watch"
  },
  "dependencies": {
    "@membranehq/sdk": "^0.7.5",
    "@temporalio/client": "^1.13.0",
    "@temporalio/common": "^1.13.0",
    "@temporalio/workflow": "^1.13.0",
    "@types/jsonwebtoken": "^9.0.10",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^8.18.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}
